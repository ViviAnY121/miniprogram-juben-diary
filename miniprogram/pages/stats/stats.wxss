.page {
  padding-bottom: 40rpx;
}

.tab-row {
  display: flex;
  background: #fff;
  margin: 20rpx;
  border-radius: 44rpx;
  padding: 6rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #888;
  border-radius: 44rpx;
}

.tab-item.active {
  background: #6c5ce7;
  color: #fff;
  font-weight: 600;
}

.year-header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0;
}

.year-title {
  font-size: 32rpx;
  font-weight: 600;
  margin: 0 30rpx;
  color: #2c2c3a;
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 40rpx;
  color: #6c5ce7;
}

.legend-row {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.legend-item {
  display: flex;
  align-items: center;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.dot-purple {
  background: #6c5ce7;
}

.dot-orange {
  background: #f0932b;
}

.chart-card {
  height: 480rpx;
}

.line-chart {
  width: 100%;
  height: 440rpx;
}

.summary-card > view {
  padding: 10rpx 0;
  font-size: 28rpx;
}

.summary-value {
  color: #6c5ce7;
  font-weight: 600;
}

.rank-list {
  margin: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid #f2f2f2;
}

.rank-item:last-child {
  border-bottom: none;
}

.rank-index {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 50%;
  background: #f0f0f0;
  color: #999;
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.rank-index.rank-0 {
  background: #ffd166;
  color: #7a5200;
}

.rank-index.rank-1 {
  background: #d6d6f5;
  color: #4b3f9e;
}

.rank-index.rank-2 {
  background: #ffcfa8;
  color: #8a4b12;
}

.rank-info {
  flex: 1;
}

.rank-name {
  font-size: 28rpx;
  color: #2c2c3a;
  font-weight: 500;
}

.rank-sub {
  font-size: 20rpx;
  color: #aaa;
  margin-top: 4rpx;
}

.rank-count {
  font-size: 26rpx;
  color: #6c5ce7;
  font-weight: 600;
}
